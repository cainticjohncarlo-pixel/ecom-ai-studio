# Copy to .env (gitignored). Only ANTHROPIC_API_KEY is needed for a live run; everything else is optional.
ANTHROPIC_API_KEY=

# Models (defaults shown)
STUDIO_RESEARCH_MODEL=claude-opus-5-5
STUDIO_WRITER_MODEL=claude-opus-5-5
STUDIO_REVIEWER_MODEL=claude-opus-5-5
STUDIO_MAX_REVISIONS=2
STUDIO_FALLBACKS=1
STUDIO_TTS=kokoro            # kokoro (local, via `npx hyperframes tts`) or silent
STUDIO_TTS_VOICE=am_michael

# Integrations: each runs live only when its values are set, otherwise it writes a dry-run payload
SLACK_WEBHOOK_URL=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
NOTION_TOKEN=
NOTION_DATABASE_ID=
GOOGLE_DRIVE_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
